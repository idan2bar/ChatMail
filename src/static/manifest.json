{
  "name": "Chat Mail",
  "description": "Makes Gmail work like a chat app",
  "version": "1.0",
  "manifest_version": 3,
  "key": "",
  "action": {
    "default_popup": "main.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "scripting",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/",
    "https://gmail.googleapis.com/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "oauth2": {
    "client_id": "165687420796-fjgln7nqk4u9ctev0smou6nrppdmr48k.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  }
}